<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F7F5FB; --white:#FFFFFF; --ink:#1E1A2E; --violet:#6C2BD9; --violet-deep:#3B1768;
    --violet-pale:#EFE8FB; --gold:#C7952F; --slate:#5B5470; --line:#E3DEF0;
    --display:'Sora',sans-serif; --body:'Inter',sans-serif; --mono:'IBM Plex Mono',monospace;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);}
  a{color:inherit;}
  .wrap{max-width:1240px;margin:0 auto;padding:0 24px;}
  .skip-link{position:absolute;left:-999px;top:0;background:var(--ink);color:#fff;padding:12px 18px;z-index:200;}
  .skip-link:focus{left:12px;top:12px;}
  a:focus-visible, button:focus-visible{outline:2px solid var(--violet);outline-offset:2px;}

  .eyebrow{font-family:var(--mono);font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--violet);margin:0 0 14px;display:flex;align-items:center;gap:10px;}
  .eyebrow::before{content:"";width:22px;height:2px;background:var(--gold);display:inline-block;}
  .h2{font-family:var(--display);font-weight:700;font-size:clamp(28px,3.6vw,42px);line-height:1.15;letter-spacing:-.01em;margin:0 0 16px;color:var(--ink);}
  .ph{position:relative;border-radius:14px;border:1.5px dashed #C9BEE6;background:repeating-linear-gradient(135deg, var(--violet-pale) 0px, var(--violet-pale) 10px, #F2EDFA 10px, #F2EDFA 20px);display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;}
  .ph span{font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;color:var(--violet-deep);background:rgba(255,255,255,.75);padding:8px 14px;border-radius:999px;max-width:80%;}

  header.site{position:sticky;top:0;z-index:50;background:rgba(247,245,251,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);}
  .nav-row{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;}
  .brand .mark{width:38px;height:38px;border-radius:9px;background:linear-gradient(150deg,var(--violet) 0%,var(--violet-deep) 100%);display:flex;align-items:center;justify-content:center;color:#fff;font-family:var(--display);font-weight:800;font-size:15px;flex-shrink:0;}
  .brand .word{font-family:var(--display);font-weight:800;font-size:17px;color:var(--ink);line-height:1.15;}
  .brand .word small{display:block;font-family:var(--body);font-weight:600;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--slate);}
  nav.links{display:none;}
  nav.links a{font-family:var(--body);font-weight:600;font-size:14.5px;color:var(--ink);text-decoration:none;margin-left:26px;position:relative;padding:6px 0;}
  nav.links a.active{color:var(--violet-deep);}
  nav.links a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:2px;background:var(--gold);transition:right .28s cubic-bezier(.4,0,.2,1);}
  nav.links a:hover::after,nav.links a.active::after{right:0;}
  .nav-actions{display:flex;align-items:center;gap:12px;}
  .phone-link{display:none;font-family:var(--mono);font-weight:600;font-size:13.5px;color:var(--ink);text-decoration:none;}
  .btn-primary{font-family:var(--body);font-weight:700;font-size:14px;color:#fff;background:var(--violet);padding:11px 22px;border-radius:8px;text-decoration:none;white-space:nowrap;transition:background .2s,transform .2s;display:inline-block;}
  .btn-primary:hover{background:var(--violet-deep);transform:translateY(-1px);}
  .btn-ghost{font-family:var(--body);font-weight:700;font-size:14px;color:var(--ink);background:transparent;border:1.5px solid var(--ink);padding:9.5px 20px;border-radius:8px;text-decoration:none;white-space:nowrap;transition:background .2s,color .2s;display:inline-block;}
  .btn-ghost:hover{background:var(--ink);color:#fff;}
  .menu-toggle{display:flex;background:var(--white);border:1px solid var(--line);border-radius:8px;width:38px;height:38px;align-items:center;justify-content:center;cursor:pointer;}
  .mobile-menu{display:none;background:var(--white);border-top:1px solid var(--line);padding:8px 24px 20px;}
  .mobile-menu a{display:block;font-family:var(--body);font-weight:600;font-size:16px;color:var(--ink);text-decoration:none;padding:12px 0;border-bottom:1px solid var(--line);}
  .mobile-menu.open{display:block;}
  @media(min-width:960px){nav.links{display:flex;align-items:center;}.menu-toggle{display:none;}.phone-link{display:block;}}

  .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s cubic-bezier(.4,0,.2,1), transform .7s cubic-bezier(.4,0,.2,1);}
  .reveal.in{opacity:1;transform:translateY(0);}

  /* Hero */
  .hero{padding:56px 24px 0;}
  .hero-grid{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;}
  h1{font-family:var(--display);font-weight:800;font-size:clamp(34px,4.4vw,50px);line-height:1.1;letter-spacing:-.015em;color:var(--ink);margin:0 0 20px;}
  .hero-copy p.lede{font-size:17px;line-height:1.65;color:var(--slate);margin:0 0 28px;max-width:480px;}
  .cta-row{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:30px;}
  .trust-strip{display:flex;flex-wrap:wrap;gap:10px 22px;}
  .trust-strip span{font-family:var(--body);font-weight:600;font-size:13px;color:var(--ink);display:flex;align-items:center;gap:7px;}
  .trust-strip span::before{content:"✓";color:var(--violet);font-weight:800;}
  .hero-photo{aspect-ratio:4/5;}
  @media(max-width:899px){.hero-grid{grid-template-columns:1fr;}.hero-photo{aspect-ratio:16/9;margin-top:16px;}}

  /* Intro */
  .intro{background:var(--white);padding:88px 24px;border-top:1px solid var(--line);}
  .intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center;}
  .intro-copy p{font-family:var(--body);font-size:15.5px;line-height:1.7;color:var(--slate);margin:0 0 18px;}
  .intro-copy ul{list-style:none;margin:22px 0 0;padding:0;display:flex;flex-direction:column;gap:12px;}
  .intro-copy li{font-family:var(--body);font-size:14.5px;color:var(--ink);display:flex;gap:10px;}
  .intro-copy li::before{content:"✓";color:var(--violet);font-weight:800;flex-shrink:0;}
  .intro-photo{aspect-ratio:4/3;}
  @media(max-width:899px){.intro-grid{grid-template-columns:1fr;}.intro-photo{order:-1;}}

  /* What's included */
  .included{background:var(--paper);padding:88px 24px;}
  .section-head{max-width:680px;margin:0 0 48px;}
  .included-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;}
  .included-card{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:28px 26px;}
  .included-card .num{font-family:var(--mono);font-weight:600;font-size:13px;color:var(--gold);display:block;margin-bottom:10px;}
  .included-card h3{font-family:var(--display);font-weight:700;font-size:19px;color:var(--ink);margin:0 0 14px;}
  .included-card ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;}
  .included-card li{font-family:var(--body);font-size:13.5px;line-height:1.5;color:var(--slate);display:flex;gap:9px;}
  .included-card li::before{content:"–";color:var(--violet);flex-shrink:0;}
  @media(max-width:899px){.included-grid{grid-template-columns:1fr;}}

  /* Bundle callout */
  .bundle{background:var(--ink);border-radius:24px;padding:40px 36px;margin-top:36px;display:grid;grid-template-columns:auto 1fr auto;gap:26px;align-items:center;}
  .bundle .icon{width:52px;height:52px;border-radius:12px;background:linear-gradient(150deg,var(--violet) 0%,var(--violet-deep) 100%);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .bundle .icon svg{width:26px;height:26px;stroke:#fff;}
  .bundle h3{font-family:var(--display);font-weight:700;font-size:19px;color:#fff;margin:0 0 6px;}
  .bundle p{font-family:var(--body);font-size:14px;color:#C9C1DD;margin:0;}
  @media(max-width:699px){.bundle{grid-template-columns:1fr;text-align:center;}.bundle .icon{margin:0 auto;}}

  /* Frequency options */
  .frequency{background:var(--white);padding:88px 24px;border-top:1px solid var(--line);}
  .freq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .freq-card{border:1px solid var(--line);border-radius:14px;padding:24px 22px;transition:border-color .2s,transform .2s;}
  .freq-card:hover{border-color:var(--violet);transform:translateY(-3px);}
  .freq-card h4{font-family:var(--display);font-weight:700;font-size:16px;color:var(--ink);margin:0 0 8px;}
  .freq-card p{font-family:var(--body);font-size:13.5px;line-height:1.55;color:var(--slate);margin:0;}
  @media(max-width:899px){.freq-grid{grid-template-columns:1fr 1fr;}}
  @media(max-width:599px){.freq-grid{grid-template-columns:1fr;}}

  /* Workplaces served */
  .served{background:var(--paper);padding:88px 24px;}
  .served-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:16px;overflow:hidden;}
  .served-item{background:var(--white);padding:26px 24px;}
  .served-item h4{font-family:var(--display);font-weight:700;font-size:15.5px;color:var(--ink);margin:0 0 8px;}
  .served-item p{font-family:var(--body);font-size:13px;line-height:1.55;color:var(--slate);margin:0;}
  @media(max-width:899px){.served-grid{grid-template-columns:1fr;}}

  /* Process */
  .process{background:var(--white);padding:88px 24px;border-top:1px solid var(--line);}
  .process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
  .step .num{font-family:var(--mono);font-weight:600;font-size:13px;color:var(--gold);display:block;margin-bottom:10px;}
  .step h4{font-family:var(--display);font-weight:700;font-size:16.5px;color:var(--ink);margin:0 0 8px;}
  .step p{font-family:var(--body);font-size:13.5px;line-height:1.55;color:var(--slate);margin:0;}
  @media(max-width:899px){.process-grid{grid-template-columns:1fr 1fr;}}
  @media(max-width:599px){.process-grid{grid-template-columns:1fr;}}

  /* Related services */
  .related{background:var(--paper);padding:80px 24px;}
  .related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .related-card{display:block;background:var(--white);border:1px solid var(--line);border-radius:16px;padding:26px 24px;text-decoration:none;transition:transform .22s cubic-bezier(.22,1,.36,1),box-shadow .22s ease,border-color .22s ease;}
  .related-card:hover{transform:translateY(-4px);box-shadow:0 18px 34px -22px rgba(59,23,104,.3);border-color:var(--violet);}
  .related-card .tag{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--violet);margin:0 0 10px;}
  .related-card h3{font-family:var(--display);font-weight:700;font-size:17px;color:var(--ink);margin:0 0 8px;}
  .related-card p{font-family:var(--body);font-size:13.5px;line-height:1.55;color:var(--slate);margin:0;}
  @media(max-width:899px){.related-grid{grid-template-columns:1fr;}}

  /* FAQ */
  .faq{background:var(--white);padding:88px 24px;border-top:1px solid var(--line);}
  .faq-list{max-width:820px;}
  .faq-item{border-top:1px solid var(--line);padding:20px 0;}
  .faq-item:last-child{border-bottom:1px solid var(--line);}
  .faq-item summary{font-family:var(--display);font-weight:700;font-size:16px;color:var(--ink);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;}
  .faq-item summary::-webkit-details-marker{display:none;}
  .faq-item summary::after{content:"+";font-family:var(--mono);font-size:20px;color:var(--violet);flex-shrink:0;transition:transform .2s ease;}
  .faq-item[open] summary::after{transform:rotate(45deg);}
  .faq-item p{font-family:var(--body);font-size:14.5px;line-height:1.65;color:var(--slate);margin:14px 0 0;max-width:700px;}
  .faq-more{margin-top:24px;font-family:var(--body);font-size:14px;}
  .faq-more a{color:var(--violet-deep);font-weight:700;text-decoration:none;border-bottom:1.5px solid var(--gold);padding-bottom:2px;}

  /* Final CTA */
  .final-cta{position:relative;background:linear-gradient(150deg,var(--violet) 0%,var(--violet-deep) 100%);padding:88px 24px;text-align:center;overflow:hidden;}
  .final-cta h2{color:#fff;max-width:620px;margin:0 auto 14px;}
  .final-cta p{font-family:var(--body);font-size:16px;color:#E7DEFB;max-width:520px;margin:0 auto 32px;}
  .final-cta .btn-primary{background:#fff;color:var(--violet-deep);}
  .final-cta .btn-primary:hover{background:var(--gold);color:#fff;}
  .final-cta .btn-ghost{border-color:#fff;color:#fff;}
  .final-cta .btn-ghost:hover{background:#fff;color:var(--violet-deep);}
  .final-cta .cta-row{justify-content:center;margin-bottom:0;}

  footer{background:#150F24;padding:56px 24px 28px;}
  .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px;padding-bottom:34px;border-bottom:1px solid #2C2447;max-width:1240px;margin:0 auto;}
  .footer-brand{display:flex;align-items:center;gap:10px;margin:0 0 14px;}
  .footer-grid p{font-family:var(--body);font-size:13.5px;color:#A79ECB;line-height:1.6;margin:0;max-width:260px;}
  .footer-col-title{font-family:var(--mono);font-weight:600;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin:0 0 14px;}
  .footer-col a{display:block;font-family:var(--body);font-size:13.5px;color:#D6D0EA;text-decoration:none;margin-bottom:10px;}
  .legal{font-family:var(--body);font-size:12px;color:#6F6690;text-align:center;padding-top:20px;line-height:1.6;max-width:1240px;margin:0 auto;}
  @media(max-width:899px){.footer-grid{grid-template-columns:1fr 1fr;}}
  @media(max-width:520px){.footer-grid{grid-template-columns:1fr;}}

  @media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important;}}
</style>
</head>
